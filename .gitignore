# ── Entorno y secretos ───────────────────────────────────────
.env
.env.local
.env.*.local

# ── Esquema de referencia (guía de desarrollo, NO fuente de verdad) ──
data/schemas.sql
data

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Entornos virtuales ────────────────────────────────────────
.venv/
venv/
env/
ENV/
.virtualenv/

# ── Build / distribución ──────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Tests y cobertura ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
