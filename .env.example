# PostgreSQL connection URL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/professor_copilot

# Opcional: URL separada para tests (se usa en pytest-postgresql)
# DATABASE_URL_TEST=postgresql://postgres:changeme@localhost:5432/professor_copilot_test
